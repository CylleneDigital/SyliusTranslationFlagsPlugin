{
    "name": "cyllene-digital/sylius-translation-flags-plugin",
    "type": "sylius-plugin",
    "description": "Sylius admin plugin that improves the translations accordions and the locales list: a flag before each locale and a capitalized locale name.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "translation",
        "i18n",
        "flag",
        "admin"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "sylius/sylius": "~2.2.0 || ~2.3.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/ux-icons": "^2.36 || ^3.0",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.2",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "~2.2.0@alpha || ~2.3.0@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/runtime": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "symfony": {
            "require": "^7.4 || ^8.0"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "CylleneDigital\\SyliusTranslationFlagsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\CylleneDigital\\SyliusTranslationFlagsPlugin\\": "tests/"
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:schema:create --force",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test": "php vendor/bin/phpunit",
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    }
}
